{
  "name": "kestrel-ci",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start:api": "node server/control-plane.mjs",
    "start:worker": "node worker/agent.mjs",
    "dev:api": "node --watch server/control-plane.mjs",
    "dev:worker": "node --watch worker/agent.mjs",
    "start": "node server/control-plane.mjs",
    "start:frontend": "vite preview --host 0.0.0.0",
    "check": "npm run lint && npm run build",
    "migrate": "node scripts/migrate.mjs",
    "preflight": "node scripts/check-env.mjs",
    "test": "node --test",
    "backup:db": "node scripts/backup-database.mjs",
    "backup:verify": "node scripts/verify-database-backup.mjs",
    "production:smoke": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "pg": "^8.16.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
