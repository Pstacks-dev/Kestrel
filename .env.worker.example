# Copy this file to .env.worker and fill in the values.
# Use the public HTTPS URL of the deployed Kestrel control-plane API.
KESTREL_API_URL=https://YOUR-KESTREL-API-DOMAIN
KESTREL_WORKER_TOKEN=PASTE_ONE_TIME_TOKEN_FROM_KESTREL_ADMIN
# Provisioned worker tokens must be at least 32 characters. Never use the development fallback in production.
KESTREL_WORKER_ID=wrk_REPLACE_WITH_PROVISIONED_WORKER_ID

# Host path visible to the Docker daemon for job-container bind mounts.
# Must match the left-hand path in docker-compose.worker.yml.
KESTREL_WORKER_HOST_WORKDIR=/srv/kestrel-worker/work
KESTREL_REGION=local
KESTREL_CONCURRENCY=1

# Pin this image to its sha256 digest for production deployments.
KESTREL_JOB_IMAGE=node:22-bookworm-slim

# "bridge" allows build steps such as npm ci to download dependencies.
# Use "none" only for jobs that do not need outbound network access.
KESTREL_JOB_NETWORK=bridge
KESTREL_JOB_PIDS_LIMIT=256
KESTREL_GIT_TIMEOUT_MS=300000
