NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# Supabase project settings. Never expose the database password or service key to the browser.
# For Vercel or serverless deployments, use the Supabase Transaction pooler (port 6543) and set DB_POOL_MAX=1.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Server-only key used by authenticated Kestrel project-file API routes
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_POOL_MAX=5
DB_SSL_REJECT_UNAUTHORIZED=true

# Control plane secret encryption (32-character or base64 key for AES-256-GCM project secrets)
KESTREL_ENCRYPTION_KEY=replace-with-at-least-32-char-encryption-key-for-secrets

# Required random secret for /api/cron/recovery and /api/cron/artifacts/cleanup
CRON_SECRET=replace-with-a-long-random-cron-secret

# Optional artifact retention. Leave blank to retain artifacts until manually deleted.
# When set, accepted range is 1-3650 days; cleanup runs from the protected cron endpoint.
KESTREL_ARTIFACT_RETENTION_DAYS=

# Provision a unique worker token in the platform admin console/API.
KESTREL_WORKER_TOKEN=replace-with-one-time-provisioned-worker-token
KESTREL_API_URL=http://127.0.0.1:4000
KESTREL_WORKER_ID=replace-with-provisioned-worker-id
KESTREL_WORKER_WORKDIR=/var/lib/kestrel-worker
KESTREL_REGION=local
KESTREL_CONCURRENCY=2

# Worker execution mode: 'docker' (default production), 'local' (host execution), or 'mock' (dry-run test mode)
KESTREL_WORKER_EXECUTOR=docker

# Runtime sandbox (in production, pin by immutable digest @sha256:...)
# Apply deploy/harden-worker-egress.sh on the Linux worker host to block private/metadata access.
KESTREL_JOB_IMAGE=ghcr.io/peterakinwale326-code/kestrel-job-node22:1.0.0
KESTREL_JOB_NETWORK=bridge
KESTREL_JOB_DEFAULT_MEMORY_MB=2048
KESTREL_JOB_DEFAULT_CPUS=2
KESTREL_JOB_PIDS_LIMIT=256
KESTREL_DOCKER_BIN=docker

# Frontend public settings (these are public keys, protected by Supabase RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=/api
KESTREL_WORKER_HOST_WORKDIR=/srv/kestrel-worker
DOCKER_GID=999
KESTREL_JOB_TIMEOUT_MS=1800000
KESTREL_GIT_TIMEOUT_MS=300000
KESTREL_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# Optional Kestrel Compute host agent settings (configure on a dedicated Linux provider host only).
# Do not add these secrets to VITE_ variables or customer build containers.
KESTREL_COMPUTE_NODE_ID=
KESTREL_COMPUTE_NODE_TOKEN=
KESTREL_COMPUTE_PROVIDER=incus
# Incus mTLS credentials
KESTREL_INCUS_ENDPOINT=https://127.0.0.1:8443
KESTREL_INCUS_PROJECT=kestrel
KESTREL_INCUS_CLIENT_CERT=/etc/kestrel/incus-client.crt
KESTREL_INCUS_CLIENT_KEY=/etc/kestrel/incus-client.key
KESTREL_INCUS_SERVER_CA=/etc/kestrel/incus-server-ca.crt
# Firecracker host paths (use only when KESTREL_COMPUTE_PROVIDER=firecracker)
KESTREL_FIRECRACKER_CHROOT_BASE=/var/lib/kestrel/jailer
KESTREL_FIRECRACKER_JAILER=/usr/bin/jailer
KESTREL_FIRECRACKER_BINARY=/usr/bin/firecracker
KESTREL_FIRECRACKER_KERNEL_DIR=/var/lib/kestrel/kernels
KESTREL_FIRECRACKER_ROOTFS_DIR=/var/lib/kestrel/rootfs
KESTREL_FIRECRACKER_BRIDGE=br-kestrel
KESTREL_COMPUTE_BRIDGE=br-kestrel
KESTREL_FIRECRACKER_UID=1000
KESTREL_FIRECRACKER_GID=1000
# KubeVirt credentials (use only when KESTREL_COMPUTE_PROVIDER=kubevirt)
KESTREL_KUBEVIRT_API_SERVER=https://kubernetes.example:6443
KESTREL_KUBEVIRT_NAMESPACE=kestrel-workloads
KESTREL_KUBEVIRT_TOKEN_FILE=/etc/kestrel/kubevirt-token
KESTREL_KUBEVIRT_CA_FILE=/etc/kestrel/kubernetes-ca.crt

# Managed sandbox compute (Vercel Sandbox provider)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
KESTREL_SANDBOX_REGION=iad1
KESTREL_SANDBOX_IMAGE=vercel/sandbox/universal
# Optional API override for provider-client tests or a future compatible provider
KESTREL_SANDBOX_API_URL=https://api.vercel.com

# GitHub App integration (server-only; never expose these as VITE_ variables).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key; store in deployment secrets, single-line escaped \\n is supported.
GITHUB_APP_PRIVATE_KEY=

# GitHub App webhook HMAC secret (configure the same value in the GitHub App settings).
GITHUB_APP_WEBHOOK_SECRET=

# Dedicated 32+ character secret for expiring GitHub installation callback state.
GITHUB_APP_STATE_SECRET=
