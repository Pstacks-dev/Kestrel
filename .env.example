NODE_ENV=development
PORT=4000
TRUST_PROXY=false

# Supabase PostgreSQL connection settings. Never expose the database password or service key to the browser.
# For Vercel or serverless deployments, use the Supabase Transaction pooler (port 6543) and set DB_POOL_MAX=1.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_POOL_MAX=5
DB_SSL_REJECT_UNAUTHORIZED=true

# Kestrel-managed email OTP delivery (Gmail SMTP uses an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_FROM_NAME=Kestrel

# Control plane secret encryption (32-character or base64 key for AES-256-GCM project secrets)
KESTREL_ENCRYPTION_KEY=replace-with-at-least-32-char-encryption-key-for-secrets

# Optional cron secret for protecting /api/cron/recovery endpoint when called by Vercel Cron
CRON_SECRET=replace-with-cron-secret-for-lease-reaper

# Provision a unique worker token in the platform admin console/API.
KESTREL_WORKER_TOKEN=replace-with-one-time-provisioned-worker-token
KESTREL_API_URL=http://127.0.0.1:4000
KESTREL_WORKER_ID=replace-with-provisioned-worker-id
KESTREL_WORKER_WORKDIR=/var/lib/kestrel-worker
KESTREL_REGION=local
KESTREL_CONCURRENCY=2

# Worker execution mode: 'docker' (default production), 'local' (host execution), or 'mock' (dry-run test mode)
KESTREL_WORKER_EXECUTOR=docker

# Runtime sandbox (in production, pin by immutable digest @sha256:...)
KESTREL_JOB_IMAGE=ghcr.io/peterakinwale326-code/kestrel-job-node22:1.0.0
KESTREL_JOB_NETWORK=none
KESTREL_JOB_DEFAULT_MEMORY_MB=2048
KESTREL_JOB_DEFAULT_CPUS=2
KESTREL_JOB_PIDS_LIMIT=256
KESTREL_DOCKER_BIN=docker

# Frontend public settings (these are public keys, protected by Supabase RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=/api
KESTREL_WORKER_HOST_WORKDIR=/srv/kestrel-worker
DOCKER_GID=999
KESTREL_JOB_TIMEOUT_MS=1800000
KESTREL_GIT_TIMEOUT_MS=300000
KESTREL_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
