{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 15
    },
    "api/proxy.mjs": {
      "maxDuration": 15
    },
    "api/cron/managed-deployments.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/recovery",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/artifacts/cleanup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/managed-deployments",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__kestrel_path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
