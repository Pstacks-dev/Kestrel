FROM node:22-alpine
RUN apk add --no-cache docker-cli git ca-certificates
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY server ./server
COPY worker ./worker
COPY db ./db
COPY scripts ./scripts
RUN mkdir -p /var/lib/kestrel /var/lib/kestrel-worker && chown -R node:node /var/lib/kestrel /var/lib/kestrel-worker
ENV NODE_ENV=production
USER node
EXPOSE 4000
CMD ["node", "server/control-plane.mjs"]
